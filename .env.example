# Required Mailcow settings
MAILCOW_URL=https://mail.example.com
MAILCOW_API_KEY=replace_me

# Polling and onboarding settings
POLL_SECONDS=60
WELCOME_FROM=no-reply@example.com
WELCOME_SUBJECT=Welcome to your new mailbox
WEBMAIL_URL=https://mail.example.com
APP_PASSWORD_URL=https://mail.example.com/user
WELCOME_TEMPLATE_TEXT=/templates/welcome-email-body.txt
WELCOME_TEMPLATE_HTML=/templates/welcome-email-body.html

# Required SMTP settings
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=replace_me
MAIL_SERVER=mail.example.com
IMAP_PORT=993

# Optional: send one test message and exit instead of polling
# SEND_TO=you@example.com

# Optional: defaults to /data/state.sqlite3 in the container
# STATE_DB=/data/state.sqlite3

# Optional custom CA bundle; certifi is used by default
# CA_FILE=/path/to/ca-bundle.crt
